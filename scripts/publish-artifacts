#!/usr/bin/env python3
"""Explicit manual publication entrypoint, used only by the protected publish job."""
import argparse
import json
import os
from pathlib import Path
import sys
import subprocess
from artifacts.publish import publish_images, publish_chart
from artifacts.release_receipt import publish_preflight

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("phase", choices=("images", "chart"))
parser.add_argument("--directory", type=Path)
parser.add_argument("--image-digest")
args = parser.parse_args()
try:
    source = os.environ["SOURCE_SHA"]
    image_version = os.environ["IMAGE_VERSION"]
    chart_version = os.environ["CHART_VERSION"]
    publish_preflight(ROOT, os.environ["RECEIPT_JSON"].encode(), os.environ["RECEIPT_SHA256"], source, image_version, chart_version, os.environ["GITHUB_REF"], os.environ["GITHUB_REPOSITORY"])
    if args.phase == "images":
        if not args.directory:
            raise ValueError("Verified archive directory is required")
        result = publish_images(args.directory, source, image_version, chart_version)
        with open(os.environ["GITHUB_OUTPUT"], "a") as output:
            for name, digest in result.items():
                output.write(f"{name}={digest}\n")
        print(json.dumps({"source_sha": source, "digests": result}, sort_keys=True))
    else:
        chart = publish_chart(ROOT, source, args.image_digest, image_version, chart_version)
        with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as output:
            output.write(f"Source: `{source}`\n\nImage: `ghcr.io/devfun2026/fork-pgdog@{args.image_digest}`\n\nChart: `oci://ghcr.io/devfun2026/charts/fork-pgdog:{chart_version}`\n\nChart OCI digest: `{chart['oci_digest']}`\n\nChart package SHA256: `{chart['package_sha256']}`\n")
except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
    print(f"Publication failed: {error}", file=sys.stderr)
    sys.exit(1)
