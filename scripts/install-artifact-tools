#!/usr/bin/env python3
"""Install checksum-bound CI tools into an explicit temporary directory."""
import argparse
import hashlib
import io
import json
import pathlib
import platform
import tarfile
import urllib.request

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--directory", required=True)
args = parser.parse_args()
if platform.system() != "Linux":
    raise SystemExit("Installer targets the Linux CI runners")
arch = {"x86_64": "amd64", "aarch64": "arm64"}[platform.machine()]
pins = json.loads((pathlib.Path(__file__).resolve().parents[1] / "tests/artifacts/tool-versions.json").read_text())
directory = pathlib.Path(args.directory)
directory.mkdir(parents=True, exist_ok=True)
for tool in ("helm", "kind", "kubectl", "trivy", "actionlint"):
    pin = pins[tool][arch]
    with urllib.request.urlopen(pin["url"], timeout=60) as response:
        data = response.read(150_000_000)
    if hashlib.sha256(data).hexdigest() != pin["sha256"]:
        raise SystemExit(f"Checksum mismatch: {tool}")
    if "member" in pin:
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as archive:
            member = archive.getmember(pin["member"])
            if not member.isfile():
                raise SystemExit(f"Not a regular executable: {tool}")
            data = archive.extractfile(member).read()
    target = directory / tool
    target.write_bytes(data)
    target.chmod(0o755)
    print(f"Installed {tool} {pins[tool]['version']}")
